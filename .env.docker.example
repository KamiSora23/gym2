# Copia este archivo como .env en el servidor y completa los valores marcados con <...>.
#   cp .env.docker.example .env

APP_NAME="GYM IMPULSO"
APP_ENV=production
APP_DEBUG=false
# Genera la clave con: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
# Tu dominio publicado en Cloudflare (con https)
APP_URL=https://<tu-dominio.com>
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
# Puerto local opcional del contenedor (con el túnel de Cloudflare no hace falta abrirlo en el firewall)
APP_PORT=8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos (el contenedor "gym-db" de docker-compose)
DB_CONNECTION=mysql
DB_HOST=gym-db
DB_PORT=3306
DB_DATABASE=gym
DB_USERNAME=gym
DB_PASSWORD=<contraseña-larga-de-la-base>
DB_ROOT_PASSWORD=<otra-contraseña-larga-para-root>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Correo (recuperar contraseña). Con "log" los correos solo quedan en storage/logs.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@<tu-dominio.com>"
MAIL_FROM_NAME="${APP_NAME}"

# Cuentas que se crean SOLO en la primera instalación (base de datos vacía).
# Cámbialas antes del primer arranque; luego puedes cambiar la contraseña desde "Mi perfil".
SUPERADMIN_NAME="Super Administrador"
SUPERADMIN_EMAIL=<tu-correo@dominio.com>
SUPERADMIN_PASSWORD=<contraseña-segura-superadmin>
ADMIN_NAME="Administrador"
ADMIN_EMAIL=<admin@tu-dominio.com>
ADMIN_PASSWORD=<contraseña-segura-admin>

# true = carga planes, productos, clientes y ventas de ejemplo en la primera instalación
GYM_DATOS_DEMO=false
